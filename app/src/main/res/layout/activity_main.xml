<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212">

    <!-- ======== TAB BAR ======== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="#1E1E1E"
        android:padding="4dp">

        <TextView
            android:id="@+id/tabScript"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="📝 Script"
            android:textColor="#FFFFFF"
            android:textAlignment="center"
            android:padding="12dp"
            android:background="#3F51B5"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tabMacro"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="🎯 Macro"
            android:textColor="#AAAAAA"
            android:textAlignment="center"
            android:padding="12dp"
            android:layout_marginStart="2dp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tabBoot"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="🚀 Boot"
            android:textColor="#AAAAAA"
            android:textAlignment="center"
            android:padding="12dp"
            android:layout_marginStart="2dp"
            android:textStyle="bold"/>
            
        <TextView
            android:id="@+id/tabLog"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="📋 Logs"
            android:textColor="#AAAAAA"
            android:textAlignment="center"
            android:padding="12dp"
            android:layout_marginStart="2dp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- ======== TAB 1: SCRIPT ======== -->
    <ScrollView
        android:id="@+id/pageScript"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="visible">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lua Script Editor"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="8dp"/>

            <EditText
                android:id="@+id/scriptInput"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:background="#1E1E1E"
                android:textColor="#00FF00"
                android:textSize="13sp"
                android:padding="12dp"
                android:fontFamily="monospace"
                android:scrollbars="vertical"/>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="💾 Save Script"
                android:layout_marginTop="8dp"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>
                
            <CheckBox
                android:id="@+id/cbAutoMacro"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Run a macro automatically with the program"
                android:textColor="#DDDDDD"
                android:buttonTint="#4CAF50"/>
                
            <CheckBox
                android:id="@+id/cbAutoBoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Run the program automatically at startup"
                android:textColor="#DDDDDD"
                android:buttonTint="#4CAF50"/>
        </LinearLayout>
    </ScrollView>

    <!-- ======== TAB 2: MACRO / AUTO CLICKER ======== -->
    <ScrollView
        android:id="@+id/pageMacro"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎯 Auto Clicker Targets"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use ⚙️ Configure to set per-target options"
                android:textColor="#888888"
                android:textSize="12sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvTargetList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="60dp"
                android:text="No targets added yet."
                android:textColor="#BBBBBB"
                android:background="#1E1E1E"
                android:padding="12dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="monospace"
                android:textSize="13sp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnAddTarget"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="➕ Add"
                    android:backgroundTint="#FF9800"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnConfigTarget"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="⚙️ Configure"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#9C27B0"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnClearTargets"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="🗑️ Clear"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#F44336"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnAddCoordTarget"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="📍 Add Coord"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnTogglePointer"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="🎈 Float Picker"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#607D8B"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnExportMacro"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="📤 Export Macro"
                    android:backgroundTint="#009688"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>

                <Button
                    android:id="@+id/btnImportMacro"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="📥 Import Macro"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="#2196F3"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"/>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#444444"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️ Global Delay Settings"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:layout_marginBottom="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="6dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Delay between targets (ms):"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"/>
                <EditText
                    android:id="@+id/etStepDelay"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="500"
                    android:textColor="#FFFFFF"
                    android:background="#2A2A2A"
                    android:padding="8dp"
                    android:textAlignment="center"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="Delay between clicks (ms):"
                    android:textColor="#CCCCCC"
                    android:textSize="13sp"/>
                <EditText
                    android:id="@+id/etClickDelay"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="200"
                    android:textColor="#FFFFFF"
                    android:background="#2A2A2A"
                    android:padding="8dp"
                    android:textAlignment="center"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnToggleService"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="▶️ START Auto Clicker"
                android:backgroundTint="#4CAF50"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="16sp"
                android:padding="16dp"/>

            <TextView
                android:id="@+id/tvServiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status: Stopped 🔴"
                android:textSize="12sp"
                android:textColor="#F44336"
                android:layout_marginTop="4dp"
                android:layout_gravity="center_horizontal"/>
        </LinearLayout>
    </ScrollView>

    <!-- ======== TAB 3: AUTO BOOT ======== -->
    <ScrollView
        android:id="@+id/pageBoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚀 Auto-Start Game on Boot"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="18sp"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Select a game to launch automatically when the device boots. Uses ROOT to force-launch the app after 10 seconds."
                android:textColor="#AAAAAA"
                android:textSize="13sp"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvBootApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Selected: None"
                android:textColor="#03A9F4"
                android:textSize="15sp"
                android:layout_marginBottom="12dp"/>

            <Button
                android:id="@+id/btnSelectBootApp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="⚙️ Select Game to Auto-Start"
                android:backgroundTint="#607D8B"
                android:textColor="#FFFFFF"
                android:textStyle="bold"/>
        </LinearLayout>
    </ScrollView>

    <!-- ======== TAB 4: LOGS ======== -->
    <ScrollView
        android:id="@+id/pageLog"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">
                
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="📋 App Logs (Logcat)"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold"
                    android:textSize="18sp"/>
                    
                <Button
                    android:id="@+id/btnRefreshLogs"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔄 Refresh"
                    android:backgroundTint="#009688"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="300dp"
                android:text="Press refresh to load logs..."
                android:textColor="#00FF00"
                android:background="#1E1E1E"
                android:padding="12dp"
                android:fontFamily="monospace"
                android:textSize="11sp"/>
                
        </LinearLayout>
    </ScrollView>

</LinearLayout>
